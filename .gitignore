# Fetched models and converted forms: never committed (see README, "A model corpus").
models/cache/
# Tools fetched and built by scripts/tools.mjs, and their packages.
tools/*/checkout/
node_modules/
# Results are committed; scratch output is not.
results/**/scratch/
# Bundled pane output, built by scripts/tools.mjs from tool.json "pane".
tools/*/dist/
# The view suite's lock while a measuring run is on (scripts/view.mjs).
results/view/.view.lock
